generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================
enum Role {
  ADMIN
  MANAGER
  NURSE
  DOCTOR
  LABORATORY
  PATIENT
  CASHIER
  RECEPTIONIST
  PHARMACIST
}

enum Status {
  ACTIVE
  INACTIVE
  DORMANT
}

enum JOBTYPE {
  FULL
  PART
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  PAID
  UNPAID
  PART
}

enum InventoryCategory {
  MEDICATION
  CONSUMABLE
  EQUIPMENT
  OTHER
}

enum LabTestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EventType {
  MEETING
  TRAINING
  HOLIDAY
  ANNOUNCEMENT
  OTHER
}

enum EventStatus {
  CONFIRMED
  CANCELLED
  DRAFT
}

enum Visibility {
  ALL
  DEPARTMENT
  ROLE
}

// ==========================
// MODELS
// ==========================
model Patient {
  id                        String   @id
  first_name                String
  last_name                 String
  date_of_birth             DateTime
  gender                    Gender   @default(MALE)
  phone                     String
  email                     String?  @unique
  marital_status            String
  address                   String
  emergency_contact_name    String?
  emergency_contact_number  String?
  relation                  String?
  blood_group               String?
  allergies                 String?
  medical_conditions        String?
  medical_history           String?
  insurance_provider        String?
  insurance_number          String?
  privacy_consent           Boolean
  service_consent           Boolean
  medical_consent           Boolean
  img                       String?
  color_code                String?

  appointments       Appointment[]
  medical            MedicalRecords[]
  payments           Payment[]
  ratings            Rating[]
  pharmacist_records PharmacistRecord[]
  medication_records MedicationAdministration[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Doctor {
  id                  String  @id
  email               String  @unique
  name                String
  specialization      String
  license_number      String
  phone               String
  address             String
  department          String?
  img                 String?
  color_code          String?
  availability_status Status  @default(ACTIVE)
  type                JOBTYPE @default(FULL)

  working_days               WorkingDays[]
  appointments               Appointment[]
  ratings                    Rating[]
  diagnosis                  Diagnosis[]
  medication_administrations  MedicationAdministration[]
  rosters                     Roster[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model WorkingDays {
  id         Int    @id @default(autoincrement())
  doctor_id  String
  day        String
  start_time DateTime
  close_time DateTime

  doctor Doctor @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Staff {
  id              String  @id
  email           String  @unique
  name            String
  phone           String
  address         String
  department      String?
  img             String?
  license_number  String?
  color_code      String?
  role            Role
  status          Status  @default(ACTIVE)

  receptions        Reception[]       @relation("ReceptionistReceptions")
  inventory_added   Inventory[]       @relation("StaffInventory")
  lab_tests         LabTest[]         @relation("LabTestTechnician")
  audit_logs        AuditLog[]        @relation("StaffAuditLogs")
  medication_records MedicationAdministration[]

  rosters           Roster[]
  leave_requests    LeaveRequest[]
  approvals         Approval[]
  created_events    Event[]           @relation("StaffCreatedEvents")
  announcements     Announcement[]    @relation("StaffAnnouncements")
  rsvps             RSVP[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model MedicationAdministration {
  id              String   @id @default(cuid())
  patient_id      String
  staff_id        String
  doctor_id       String?
  medication      String
  dosage          String
  administered_at DateTime
  notes           String?

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  doctor  Doctor? @relation(fields: [doctor_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Appointment {
  id               Int               @id @default(autoincrement())
  patient_id       String
  doctor_id        String
  appointment_date DateTime
  time             String
  status           AppointmentStatus @default(PENDING)
  type             String
  note             String?
  reason           String?

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  bills   Payment[]
  medical MedicalRecords[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Payment {
  id             Int           @id @default(autoincrement())
  bill_id        Int?
  patient_id     String
  appointment_id Int           @unique
  bill_date      DateTime
  payment_date   DateTime
  discount       Float
  total_amount   Float
  amount_paid    Float
  payment_method PaymentMethod @default(CASH)
  status         PaymentStatus @default(UNPAID)
  receipt_number Int           @default(autoincrement())

  appointment Appointment @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  bills       PatientBills[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PatientBills {
  id           Int      @id @default(autoincrement())
  bill_id      Int
  service_id   Int
  service_date DateTime
  quantity     Int
  unit_cost    Float
  total_cost   Float

  service Services @relation(fields: [service_id], references: [id], onDelete: Cascade)
  payment Payment  @relation(fields: [bill_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model LabTest {
  id              Int           @id @default(autoincrement())
  record_id       Int
  test_date       DateTime
  result          String
  units           String?
  reference_range String?
  status          LabTestStatus @default(PENDING)
  notes           String?
  service_id      Int
  technician_id   String?

  services       Services       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  medical_record MedicalRecords @relation(fields: [record_id], references: [id], onDelete: Cascade)
  technician     Staff?         @relation("LabTestTechnician", fields: [technician_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model MedicalRecords {
  id             Int     @id @default(autoincrement())
  patient_id     String
  appointment_id Int
  doctor_id      String
  treatment_plan String?
  prescriptions  String?
  lab_request    String?
  notes          String?

  appointment Appointment  @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  lab_test    LabTest[]
  vital_signs VitalSigns[]
  diagnosis   Diagnosis[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model VitalSigns {
  id         Int    @id @default(autoincrement())
  patient_id String
  medical_id Int

  medical MedicalRecords @relation(fields: [medical_id], references: [id], onDelete: Cascade)

  body_temperature  Float
  systolic          Int
  diastolic         Int
  heart_rate        String
  respiratory_rate  Int?
  oxygen_saturation Int?
  weight            Float
  height            Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Diagnosis {
  id         Int    @id @default(autoincrement())
  patient_id String
  medical_id Int
  doctor_id  String

  doctor  Doctor         @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  medical MedicalRecords @relation(fields: [medical_id], references: [id], onDelete: Cascade)

  symptoms               String
  diagnosis              String
  notes                  String?
  prescribed_medications String?
  follow_up_plan         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model AuditLog {
  id       Int     @id @default(autoincrement())
  user_id  String?
  user     Staff?  @relation("StaffAuditLogs", fields: [user_id], references: [id], onDelete: SetNull)

  actor_type String  @default("SYSTEM")
  actor_name String?

  record_id String
  action    String
  details   String?
  model     String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Rating {
  id         Int     @id @default(autoincrement())
  staff_id   String
  patient_id String
  rating     Int
  comment    String?

  doctor  Doctor  @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Services {
  id           Int    @id @default(autoincrement())
  service_name String
  description  String
  price        Float

  lab_tests LabTest[]
  bills     PatientBills[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PharmacistRecord {
  id                 Int      @id @default(autoincrement())
  medication_name    String
  dosage             String
  quantity           Int
  patient_id         String
  prescription_date  DateTime
  pharmacist_notes   String?

  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  inventory_item_id Int?
  inventory_item    Inventory? @relation("InventoryDispenses", fields: [inventory_item_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Reception {
  id             Int       @id @default(autoincrement())
  staff_id       String
  check_in_time  DateTime
  check_out_time DateTime?
  notes          String?

  receptionist Staff @relation("ReceptionistReceptions", fields: [staff_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Inventory {
  id             Int               @id @default(autoincrement())
  name           String
  category       InventoryCategory
  description    String?
  quantity       Int               @default(0)
  unit           String
  reorder_level  Int               @default(10)
  cost_price     Float
  selling_price  Float?
  batch_number   String?
  expiry_date    DateTime?
  supplier       String?
  last_restocked DateTime          @default(now())
  status         Status            @default(ACTIVE)

  dispenses    PharmacistRecord[] @relation("InventoryDispenses")
  added_by_id  String?
  added_by     Staff?             @relation("StaffInventory", fields: [added_by_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Shift {
  id         Int       @id @default(autoincrement())
  name       String
  type       ShiftType
  start_time DateTime
  end_time   DateTime
  notes      String?

  rosters Roster[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Roster {
  id         Int      @id @default(autoincrement())
  shift_id   Int
  staff_id   String?
  doctor_id  String?
  date       DateTime
  status     Status   @default(ACTIVE)

  start_time DateTime
  end_time   DateTime

  shift   Shift  @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  staff   Staff? @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  doctor  Doctor? @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model LeaveType {
  id          Int    @id @default(autoincrement())
  name        String
  description String?
  max_days    Int?

  requests LeaveRequest[]
}

model LeaveRequest {
  id         Int        @id @default(autoincrement())
  staff_id   String
  type_id    Int
  start_date DateTime
  end_date   DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  duration   Int

  staff     Staff     @relation(fields: [staff_id], references: [id], onDelete: Cascade)
  type      LeaveType @relation(fields: [type_id], references: [id], onDelete: Cascade)
  approvals Approval[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Approval {
  id          Int        @id @default(autoincrement())
  leave_id    Int
  approver_id String
  decision    LeaveStatus
  comments    String?

  leave    LeaveRequest @relation(fields: [leave_id], references: [id], onDelete: Cascade)
  approver Staff        @relation(fields: [approver_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  type          EventType
  start_date    DateTime
  end_date      DateTime
  location      String?
  status        EventStatus @default(CONFIRMED)  // 👈 NEW FIELD
  created_by_id String

  created_by Staff @relation("StaffCreatedEvents", fields: [created_by_id], references: [id], onDelete: Cascade)
  rsvps      RSVP[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Announcement {
  id            Int      @id @default(autoincrement())
  title         String
  message       String
  published_at  DateTime @default(now())
  created_by_id String

  created_by Staff @relation("StaffAnnouncements", fields: [created_by_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model RSVP {
  id       Int  @id @default(autoincrement())
  event_id Int
  staff_id String
  response Boolean

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([event_id, staff_id], name: "event_id_staff_id") // 👈 Ensures one RSVP per staff/event
}